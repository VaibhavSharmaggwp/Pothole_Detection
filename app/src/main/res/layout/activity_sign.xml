<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".SignActivity">

    <!-- ProgressBar for Sign-In -->
    <ProgressBar
        android:id="@+id/signInProgressBar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drive_ease_"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />


    </LinearLayout>

    <!-- Greeting Section -->
    <LinearLayout
        android:id="@+id/greetingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hi_there_"
            android:textColor="#000000"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_to_drive_ease_community_dashboard_"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Sign-In Options -->
    <LinearLayout
        android:id="@+id/signInOptionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/greetingLayout"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Google Sign-In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleSignInBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Log in with Google"
            android:textColor="#000000"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/google_logo"
            app:iconGravity="textStart"
            app:iconPadding="24dp"
            app:iconSize="20dp"
            app:iconTint="@null"
            android:backgroundTint="#FFFFFF"
            app:strokeColor="#CCCCCC"
            app:strokeWidth="1dp" />

        <!-- Divider with "or" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginVertical="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#CCCCCC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="or"
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_marginHorizontal="16dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#CCCCCC" />
        </LinearLayout>

        <!-- Email Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#CCCCCC"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="#999999"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/signInEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/your_email_newui"
                android:inputType="textEmailAddress"
                android:textColor="#000000"
                android:textColorHint="#999999" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Input Field with Forgot Password Link -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/signInPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#CCCCCC"
            android:layout_marginTop="10dp"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="#999999"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/signInPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#999999" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Log In Button -->
        <com.google.android.material.button.MaterialButton

            android:id="@+id/signInBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Log In"
            android:textColor="#FFFFFF"
            android:textAllCaps="true"
            android:layout_marginTop="10dp"
            android:textSize="18sp"
            android:backgroundTint="#000000"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Bottom Section with Sign Up and Admin Login -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/don_t_have_an_account"
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/signUpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign_up_newui"
            android:textColor="#0000FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/__"
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/admin_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_login"
            android:textColor="#0000FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>