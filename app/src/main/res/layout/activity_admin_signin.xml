<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Admin_Signin">

    <ProgressBar
        android:id="@+id/adminSignInProgressBar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Panel"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Greeting Section -->
    <LinearLayout
        android:id="@+id/greetingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Admin"
            android:textColor="#000000"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to access administration features"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Sign-In Options -->
    <LinearLayout
        android:id="@+id/signInOptionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/greetingLayout"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Google Sign-In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminGoogleSignInBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text= "Sign in with Google"
            android:textColor="#000000"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/google_logo"
            app:iconGravity="textStart"
            app:iconPadding="24dp"
            app:iconSize="20dp"
            app:iconTint="@null"
            android:backgroundTint="#FFFFFF"
            app:strokeColor="#CCCCCC"
            app:strokeWidth="1dp" />

        <!-- Divider with "or" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginVertical="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#CCCCCC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="or"
                android:textSize="20sp"
                android:textColor="#000000"
                android:layout_marginHorizontal="16dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#CCCCCC" />
        </LinearLayout>

        <!-- Email Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/adminEmailLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#CCCCCC"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="#999999"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/adminEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Admin Email"
                android:inputType="textEmailAddress"
                android:textColor="#000000"
                android:textColorHint="#999999" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/adminPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#CCCCCC"
            android:layout_marginTop="10dp"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="#999999"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/adminPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Admin Password"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#999999" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sign In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminSignInBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Admin Sign In"
            android:textColor="#FFFFFF"
            android:textAllCaps="true"
            android:layout_marginTop="10dp"
            android:textSize="18sp"
            android:backgroundTint="#000000"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Bottom Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New administrator?"
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/adminSignUpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Request Access"
            android:textColor="#0000FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>